{
 "name": "s4-radit-revision",
 "url": "http://127.0.0.1:8101/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "radit@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "css=.todo a:has-text('Review hasil Materi Iklan'):has-text('Pendaftaran Sekolah 2027')"
  },
  {
   "hover": "css=.todo a:has-text('Review hasil Materi Iklan'):has-text('Pendaftaran Sekolah 2027')",
   "zoom": 1.4,
   "pauseAfter": 1600
  },
  {
   "click": "css=.todo a:has-text('Review hasil Materi Iklan'):has-text('Pendaftaran Sekolah 2027')"
  },
  {
   "waitFor": "css=#task-panel #review"
  },
  {
   "hover": "css=#task-panel #review",
   "zoom": 1.3,
   "pauseAfter": 1800
  },
  {
   "type": "Tambahkan jadwal pendaftaran gelombang 2 dan logo sekolah.",
   "into": "css=#task-panel textarea[name=review_note]",
   "zoom": 1.4
  },
  {
   "click": {
    "find": "role=button[name='Kembalikan untuk revisi']",
    "within": "css=#task-panel"
   },
   "pauseAfter": 1500
  },
  {
   "waitFor": "css=#task-panel .revision-note"
  },
  {
   "hover": "css=#task-panel .revision-note",
   "zoom": 1.4,
   "pauseAfter": 2600
  }
 ]
}
