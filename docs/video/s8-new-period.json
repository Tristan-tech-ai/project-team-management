{
 "name": "s8-new-period",
 "url": "http://127.0.0.1:8101/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "radit@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "#todo-title"
  },
  {
   "press": "Mod+K",
   "pauseAfter": 300
  },
  {
   "type": "pendaftaran 2027",
   "into": "#palette-input",
   "zoom": 1.3
  },
  {
   "waitFor": "css=.palette-item .palette-label:text-is('Campaign Pendaftaran Sekolah 2027')"
  },
  {
   "pause": 900
  },
  {
   "press": "Enter",
   "pauseAfter": 600
  },
  {
   "waitFor": "role=link[name='Papan Kanban']"
  },
  {
   "click": {
    "find": "role=link[name='Ringkasan']",
    "exact": true
   }
  },
  {
   "waitFor": "css=#period"
  },
  {
   "hover": "css=#period",
   "zoom": 1.4,
   "pauseAfter": 1200
  },
  {
   "click": "role=button[name='Buka periode baru']",
   "pauseAfter": 600
  },
  {
   "waitFor": "css=#confirm-modal [data-confirm-yes]"
  },
  {
   "pause": 1600
  },
  {
   "click": "css=#confirm-modal [data-confirm-yes]",
   "pauseAfter": 1200
  },
  {
   "waitFor": "[data-kanban]"
  },
  {
   "hover": "css=#b-period",
   "zoom": 1.4,
   "pauseAfter": 1800
  },
  {
   "hover": "[data-kanban]",
   "zoom": false,
   "pauseAfter": 2600
  }
 ]
}
