{
 "name": "s2-kanban-panel",
 "url": "http://127.0.0.1:8101/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "radit@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "#todo-title"
  },
  {
   "press": "Mod+K",
   "pauseAfter": 300
  },
  {
   "type": "pendaftaran 2027",
   "into": "#palette-input",
   "zoom": 1.3
  },
  {
   "waitFor": "css=.palette-item .palette-label:text-is('Campaign Pendaftaran Sekolah 2027')"
  },
  {
   "pause": 900
  },
  {
   "press": "Enter",
   "pauseAfter": 600
  },
  {
   "waitFor": "role=link[name='Papan Kanban']"
  },
  {
   "click": "role=link[name='Papan Kanban']"
  },
  {
   "waitFor": "[data-kanban]"
  },
  {
   "drag": "css=[data-task-id]:has(a.task-title:text-is('Riset Audiens')) .task-handle",
   "to": "[data-kanban-column][data-status=in_progress]",
   "pauseAfter": 1500
  },
  {
   "waitFor": "css=.toast-area .alert-success"
  },
  {
   "drag": "css=[data-task-id]:has(a.task-title:text-is('Riset Audiens')) .task-handle",
   "to": "[data-kanban-column][data-status=done]",
   "pauseAfter": 400
  },
  {
   "waitFor": "css=.toast-area .alert-danger"
  },
  {
   "hover": "css=.toast-area .alert-danger",
   "zoom": 1.6,
   "pauseAfter": 2600
  },
  {
   "click": "css=a.task-title:text-is('Materi Iklan')",
   "pauseAfter": 600
  },
  {
   "waitFor": "css=#task-panel [data-task-panel-content]"
  },
  {
   "pause": 1200
  },
  {
   "scroll": {
    "to": "css=#task-panel form[action$='/assignees']"
   },
   "in": "css=#task-panel .offcanvas-body"
  },
  {
   "select": "Putri Maharani",
   "in": "css=#task-panel select[name=pic_user_id]",
   "zoom": 1.3
  },
  {
   "click": "css=#task-panel label[for=as-5]"
  },
  {
   "click": {
    "find": "role=button[name='Simpan PIC dan pelaksana']",
    "within": "css=#task-panel"
   },
   "pauseAfter": 1200
  },
  {
   "waitFor": "css=#task-panel dd:text-is('Putri Maharani')"
  },
  {
   "scroll": {
    "to": "css=#task-panel #checklist"
   },
   "in": "css=#task-panel .offcanvas-body"
  },
  {
   "type": "Brief visual brosur",
   "into": "css=#task-panel #new-subtask",
   "zoom": 1.3
  },
  {
   "click": {
    "find": "role=button[name='Tambah']",
    "within": "css=#task-panel"
   },
   "pauseAfter": 1200
  },
  {
   "waitFor": "css=#task-panel .checklist label:text-is('Brief visual brosur')"
  },
  {
   "type": "Desain feed Instagram",
   "into": "css=#task-panel #new-subtask"
  },
  {
   "click": {
    "find": "role=button[name='Tambah']",
    "within": "css=#task-panel"
   },
   "pauseAfter": 1200
  },
  {
   "waitFor": "css=#task-panel .checklist label:text-is('Desain feed Instagram')"
  },
  {
   "pause": 1200
  },
  {
   "press": "Escape",
   "pauseAfter": 2000
  },
  {
   "hover": "css=[data-task-id]:has(a.task-title:text-is('Materi Iklan'))",
   "zoom": 1.5,
   "pauseAfter": 2600
  }
 ]
}
