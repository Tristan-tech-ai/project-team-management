{
 "name": "s3-putri-kirim",
 "url": "http://127.0.0.1:8102/masuk",
 "viewport": "phone",
 "steps": [
  {
   "pause": 500
  },
  {
   "type": "putri@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 500
  },
  {
   "goto": "/tasks"
  },
  {
   "waitFor": "text=Materi Iklan"
  },
  {
   "pause": 1200
  },
  {
   "click": "text=Materi Iklan",
   "pauseAfter": 600
  },
  {
   "waitFor": "role=heading[name='Materi Iklan']"
  },
  {
   "click": "#checklist li:first-child [data-centang]",
   "pauseAfter": 1200
  },
  {
   "type": "https://drive.example.test/brosur-ppdb-v1",
   "into": "label=Tautan hasil"
  },
  {
   "type": "Draf brosur dan caption, mohon dicek.",
   "into": "label=Catatan singkat"
  },
  {
   "click": "role=button[name='Kirim untuk Review']",
   "pauseAfter": 800
  },
  {
   "waitFor": "text=Menunggu PIC atau manager meninjau hasil."
  },
  {
   "scroll": {
    "to": "top"
   },
   "pauseAfter": 2200
  }
 ]
}