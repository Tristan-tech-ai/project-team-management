{
 "name": "s11-datatables-520",
 "url": "http://127.0.0.1:8101/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "radit@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "#todo-title"
  },
  {
   "goto": "/projects/4/tasks"
  },
  {
   "waitFor": "css=.dt-info"
  },
  {
   "hover": "css=.dt-info",
   "zoom": 1.4,
   "pauseAfter": 1600
  },
  {
   "scroll": {
    "to": "css=.dt-paging"
   },
   "zoom": false,
   "pauseAfter": 600
  },
  {
   "click": "css=.dt-paging button[data-dt-idx='1']",
   "zoom": 1.4,
   "pauseAfter": 1400
  },
  {
   "hover": "css=.dt-info",
   "zoom": 1.4,
   "pauseAfter": 1400
  },
  {
   "scroll": {
    "to": "top"
   },
   "zoom": false,
   "pauseAfter": 500
  },
  {
   "type": "512",
   "into": "css=.dt-search input",
   "zoom": 1.4,
   "pauseAfter": 1600
  },
  {
   "hover": "css=.dt-info",
   "zoom": 1.4,
   "pauseAfter": 2400
  }
 ]
}
