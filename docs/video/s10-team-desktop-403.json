{
 "name": "s10-team-desktop-403",
 "url": "http://127.0.0.1:8102/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "allowOrigins": [
  "http://127.0.0.1:8101"
 ],
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "putri@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "main"
  },
  {
   "hover": "css=nav.desktop-sidebar",
   "zoom": 1.3,
   "pauseAfter": 1400
  },
  {
   "click": "css=nav.desktop-sidebar a.side-link:has-text('Task Saya')",
   "pauseAfter": 900
  },
  {
   "waitFor": "main"
  },
  {
   "scroll": {
    "to": "bottom"
   },
   "zoom": false,
   "pauseAfter": 1500
  },
  {
   "goto": "http://127.0.0.1:8101/login"
  },
  {
   "pause": 500
  },
  {
   "type": "putri@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "main"
  },
  {
   "goto": "http://127.0.0.1:8101/management"
  },
  {
   "waitFor": "css=h1.h3"
  },
  {
   "hover": "css=h1.h3",
   "zoom": 1.4,
   "pauseAfter": 2400
  }
 ]
}
