{
 "name": "s1-create-project",
 "url": "http://127.0.0.1:8101/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "radit@example.test",
   "into": "label=Email",
   "zoom": 1.4
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "#todo-title"
  },
  {
   "hover": "css=section.todo",
   "zoom": 1.3,
   "pauseAfter": 2200
  },
  {
   "click": "css=.admin-header .header-actions .dropdown > button.btn-primary"
  },
  {
   "click": {
    "find": "text=Project",
    "within": "css=.create-menu"
   },
   "pauseAfter": 400
  },
  {
   "waitFor": "role=heading[name='Buat project']"
  },
  {
   "select": "SMA Harapan Bangsa",
   "in": "label=Client",
   "zoom": 1.3
  },
  {
   "type": "Campaign Pendaftaran Sekolah 2027",
   "into": "label=Nama project"
  },
  {
   "select": "Berkelanjutan",
   "in": "css=select[name=project_type]"
  },
  {
   "select": "Digital Marketing Campaign (Berkelanjutan)",
   "in": "css=select[name=project_template_id]",
   "showList": true
  },
  {
   "waitFor": "text=akan dibuat"
  },
  {
   "hover": "[data-preview]",
   "zoom": 1.5,
   "pauseAfter": 2200
  },
  {
   "click": "label[for=dv-1]",
   "zoom": 1.3
  },
  {
   "click": "label[for=dv-2]"
  },
  {
   "click": "label[for=dv-3]"
  },
  {
   "type": "putri",
   "into": "css=.people-filter input",
   "zoom": 1.4
  },
  {
   "click": "label[for=mb-7]"
  },
  {
   "type": "ayu",
   "into": "css=.people-filter input"
  },
  {
   "click": "label[for=mb-5]"
  },
  {
   "type": "binda",
   "into": "css=.people-filter input"
  },
  {
   "click": "label[for=mb-6]",
   "pauseAfter": 900
  },
  {
   "click": "role=button[name='Buat project dan task']",
   "pauseAfter": 800
  },
  {
   "waitFor": "[data-kanban]"
  },
  {
   "hover": "[data-kanban]",
   "zoom": false,
   "pauseAfter": 2600
  }
 ]
}
