{
 "name": "s3-putri-submit",
 "url": "http://127.0.0.1:8102/login",
 "locale": "id-ID",
 "timezone": "Asia/Makassar",
 "timeout": 30000,
 "viewport": "phone",
 "steps": [
  {
   "pause": 600
  },
  {
   "type": "putri@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 600
  },
  {
   "waitFor": "css=.mobile-bottom-nav"
  },
  {
   "click": "css=.mobile-bottom-nav a:has-text('Tasks')"
  },
  {
   "waitFor": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan')"
  },
  {
   "scroll": {
    "to": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan')"
   },
   "pauseAfter": 900
  },
  {
   "click": {
    "find": "role=button[name='Mulai']",
    "within": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan')"
   },
   "pauseAfter": 1200
  },
  {
   "waitFor": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan') a:has-text('Kirim hasil')"
  },
  {
   "scroll": {
    "to": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan')"
   },
   "pauseAfter": 900
  },
  {
   "click": {
    "find": "text=Kirim hasil",
    "within": "css=article.task-tile:has-text('Pendaftaran Sekolah 2027'):has-text('Materi Iklan')"
   }
  },
  {
   "waitFor": "css=#task-panel #submit-result"
  },
  {
   "pause": 1000
  },
  {
   "scroll": {
    "to": "css=#task-panel #checklist"
   },
   "in": "css=#task-panel .offcanvas-body"
  },
  {
   "click": "css=#task-panel .checklist li:first-child label",
   "pauseAfter": 1200
  },
  {
   "scroll": {
    "to": "css=#task-panel #submit-result"
   },
   "in": "css=#task-panel .offcanvas-body"
  },
  {
   "type": "https://drive.example.test/brosur-ppdb-v1",
   "into": "css=#task-panel input[name=external_url]"
  },
  {
   "type": "Draf brosur dan caption, mohon dicek.",
   "into": "css=#task-panel textarea[name=submission_note]"
  },
  {
   "click": {
    "find": "role=button[name='Kirim untuk Review']",
    "within": "css=#task-panel"
   },
   "pauseAfter": 1500
  },
  {
   "waitFor": "text=Menunggu PIC atau manager meninjau hasil."
  },
  {
   "pause": 2200
  },
  {
   "click": "css=#task-panel button[data-bs-dismiss]",
   "pauseAfter": 2000
  }
 ]
}
