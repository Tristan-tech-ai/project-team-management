{
 "name": "s8-periode-baru",
 "url": "http://127.0.0.1:8101/masuk",
 "steps": [
  {
   "pause": 500
  },
  {
   "type": "radit@example.test",
   "into": "label=Email"
  },
  {
   "type": "$secret:PASSWORD",
   "into": "label=Kata sandi"
  },
  {
   "click": "role=button[name='Masuk']",
   "pauseAfter": 500
  },
  {
   "goto": "/projects/9"
  },
  {
   "waitFor": "#periode"
  },
  {
   "select": "Semua periode",
   "in": "#periode",
   "showList": true,
   "pauseAfter": 800
  },
  {
   "click": "role=button[name='Buka periode baru']",
   "pauseAfter": 600
  },
  {
   "waitFor": "#modal-konfirmasi [data-ya]"
  },
  {
   "pause": 1600
  },
  {
   "click": "#modal-konfirmasi [data-ya]",
   "pauseAfter": 900
  },
  {
   "waitFor": "[data-kanban]"
  },
  {
   "hover": "#b-periode",
   "zoom": 1.4,
   "pauseAfter": 1600
  },
  {
   "hover": "[data-kanban]",
   "zoom": false,
   "pauseAfter": 1800
  },
  {
   "select": "Periode 1 Nov 2026 sampai 30 Nov 2026",
   "in": "#b-periode",
   "showList": true,
   "pauseAfter": 700
  },
  {
   "click": "role=button[name='Saring']",
   "pauseAfter": 900
  },
  {
   "waitFor": "[data-kanban]"
  },
  {
   "hover": "[data-kanban]",
   "zoom": false,
   "pauseAfter": 2600
  }
 ]
}